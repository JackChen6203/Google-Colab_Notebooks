diff --git a/comfy/xla_support.py b/comfy/xla_support.py
new file mode 100644
index 0000000..ef6cc1a
--- /dev/null
+++ b/comfy/xla_support.py
@@ -0,0 +1,68 @@
+"""Small, single-device adapter for the legacy PyTorch/XLA runtime.
+
+This is experimental glue for PyTorch/XLA 2.9. It deliberately does not enable
+SPMD, custom XLA kernels, or silent fallback to CPU.
+"""
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import Any
+
+import torch
+
+
+@dataclass(frozen=True)
+class XlaRuntime:
+    """The XLA module and one local device selected by PyTorch/XLA."""
+
+    xm: Any
+    torch_xla: Any
+    device: torch.device
+
+    @classmethod
+    def initialize(cls) -> "XlaRuntime":
+        try:
+            import torch_xla
+            import torch_xla.core.xla_model as xm
+            from torch_xla import runtime as xr
+        except ImportError as exc:
+            raise RuntimeError(
+                "--xla requires a matching PyTorch/XLA install; install PyTorch/XLA "
+                "for this Python/PyTorch runtime before starting ComfyUI."
+            ) from exc
+
+        device_type = xr.device_type()
+        if str(device_type).upper() != "TPU":
+            raise RuntimeError(f"--xla currently supports a TPU PJRT runtime; detected {device_type!r}")
+        device = xm.xla_device()
+        if not isinstance(device, torch.device) or device.type != "xla":
+            raise RuntimeError(f"PyTorch/XLA returned an unexpected device: {device!r}")
+        return cls(xm=xm, torch_xla=torch_xla, device=device)
+
+    def memory_info(self) -> tuple[int, int]:
+        """Return (used_bytes, limit_bytes) reported by XLA for the local device."""
+        info = self.xm.get_memory_info(self.device)
+        try:
+            used = int(info["bytes_used"])
+            limit = int(info["bytes_limit"])
+        except (KeyError, TypeError, ValueError) as exc:
+            raise RuntimeError(f"Invalid PyTorch/XLA memory report: {info!r}") from exc
+        if used < 0 or limit <= 0 or used > limit:
+            raise RuntimeError(f"Invalid PyTorch/XLA memory report: {info!r}")
+        return used, limit
+
+    def mark_step(self) -> None:
+        """Flush one denoising step so LazyTensor graphs do not grow across steps."""
+        sync = getattr(self.torch_xla, "sync", None)
+        if callable(sync):
+            sync()
+        else:
+            self.xm.mark_step()
+
+    def synchronize(self) -> None:
+        """Wait until queued XLA work completes, using the 2.9 API when present."""
+        sync = getattr(self.torch_xla, "sync", None)
+        if callable(sync):
+            sync(wait=True)
+            return
+        self.xm.mark_step(wait=True)
diff --git a/tests-unit/comfy_test/test_xla_support.py b/tests-unit/comfy_test/test_xla_support.py
new file mode 100644
index 0000000..300c7f0
--- /dev/null
+++ b/tests-unit/comfy_test/test_xla_support.py
@@ -0,0 +1,112 @@
+import importlib.util
+import sys
+import types
+import unittest
+from pathlib import Path
+from unittest.mock import Mock, call, patch
+
+
+ROOT = Path(__file__).resolve().parents[2]
+MODULE_PATH = ROOT / "comfy" / "xla_support.py"
+
+
+class FakeDevice:
+    def __init__(self, name):
+        self.type = name.split(":", 1)[0]
+        self.name = name
+
+    def __repr__(self):
+        return self.name
+
+
+class XlaSupportTests(unittest.TestCase):
+    def load_module(self, torch_module):
+        spec = importlib.util.spec_from_file_location("xla_support_under_test", MODULE_PATH)
+        module = importlib.util.module_from_spec(spec)
+        with patch.dict(sys.modules, {"torch": torch_module}):
+            sys.modules[spec.name] = module
+            spec.loader.exec_module(module)
+        return module
+
+    def fake_runtime_modules(self, memory=None):
+        torch_module = types.ModuleType("torch")
+        torch_module.device = FakeDevice
+        xla_module = types.ModuleType("torch_xla")
+        xla_module.sync = Mock()
+        core_module = types.ModuleType("torch_xla.core")
+        runtime_module = types.ModuleType("torch_xla.runtime")
+        runtime_module.device_type = Mock(return_value="TPU")
+        xm_module = types.ModuleType("torch_xla.core.xla_model")
+        xm_module.xla_device = Mock(return_value=FakeDevice("xla:0"))
+        xm_module.get_memory_info = Mock(return_value=memory or {"bytes_used": "1024", "bytes_limit": 8192})
+        xm_module.mark_step = Mock()
+        xm_module.wait_device_ops = Mock()
+        core_module.xla_model = xm_module
+        xla_module.core = core_module
+        xla_module.runtime = runtime_module
+        modules = {
+            "torch": torch_module,
+            "torch_xla": xla_module,
+            "torch_xla.core": core_module,
+            "torch_xla.runtime": runtime_module,
+            "torch_xla.core.xla_model": xm_module,
+        }
+        return torch_module, xla_module, xm_module, runtime_module, modules
+
+    def test_initialize_and_read_memory(self):
+        torch_module, _, xm_module, runtime_module, modules = self.fake_runtime_modules()
+        with patch.dict(sys.modules, modules):
+            support = self.load_module(torch_module)
+            runtime = support.XlaRuntime.initialize()
+            self.assertEqual(runtime.device.type, "xla")
+            self.assertEqual(runtime.memory_info(), (1024, 8192))
+            xm_module.xla_device.assert_called_once_with()
+            runtime_module.device_type.assert_called_once_with()
+
+    def test_non_tpu_backend_is_rejected(self):
+        torch_module, _, _, runtime_module, modules = self.fake_runtime_modules()
+        runtime_module.device_type.return_value = "CPU"
+        with patch.dict(sys.modules, modules):
+            support = self.load_module(torch_module)
+            with self.assertRaisesRegex(RuntimeError, "supports a TPU PJRT runtime"):
+                support.XlaRuntime.initialize()
+
+    def test_invalid_memory_report_fails_closed(self):
+        torch_module, _, _, _, modules = self.fake_runtime_modules({"bytes_used": 9000, "bytes_limit": 8192})
+        with patch.dict(sys.modules, modules):
+            support = self.load_module(torch_module)
+            runtime = support.XlaRuntime.initialize()
+            with self.assertRaisesRegex(RuntimeError, "Invalid PyTorch/XLA memory report"):
+                runtime.memory_info()
+
+    def test_mark_step_and_synchronize(self):
+        torch_module, xla_module, xm_module, _, modules = self.fake_runtime_modules()
+        with patch.dict(sys.modules, modules):
+            support = self.load_module(torch_module)
+            runtime = support.XlaRuntime.initialize()
+            runtime.mark_step()
+            runtime.synchronize()
+            xm_module.mark_step.assert_not_called()
+            xla_module.sync.assert_has_calls([call(), call(wait=True)])
+
+    def test_synchronize_uses_mark_step_fallback(self):
+        torch_module, xla_module, xm_module, _, modules = self.fake_runtime_modules()
+        delattr(xla_module, "sync")
+        with patch.dict(sys.modules, modules):
+            support = self.load_module(torch_module)
+            runtime = support.XlaRuntime.initialize()
+            runtime.mark_step()
+            runtime.synchronize()
+            xm_module.mark_step.assert_has_calls([call(), call(wait=True)])
+
+    def test_missing_runtime_has_actionable_error(self):
+        torch_module = types.ModuleType("torch")
+        torch_module.device = FakeDevice
+        support = self.load_module(torch_module)
+        with patch.dict(sys.modules, {"torch": torch_module, "torch_xla": None}):
+            with self.assertRaisesRegex(RuntimeError, "--xla requires a matching PyTorch/XLA install"):
+                support.XlaRuntime.initialize()
+
+
+if __name__ == "__main__":
+    unittest.main()
